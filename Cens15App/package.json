{
  "name": "cens15app",
  "version": "1.0.0",
  "packageManager": "pnpm@10.18.2",
  "main": "index.ts",
  "scripts": {
    "start": "pnpm run dev:local-api",
    "dev:local-api": "env-cmd -f .env.local-api -- expo start --lan",
    "dev:prod-api": "env-cmd -f .env.prod-api -- expo start --lan",
    "web:local-api": "env-cmd -f .env.local-api -- expo start --web",
    "web:prod-api": "env-cmd -f .env.prod-api -- expo start --web",
    "build:web:prod": "env-cmd -f .env.production -- expo export --platform web --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@reduxjs/toolkit": "^2.5.0",
    "expo": "^57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-local-authentication": "~57.0.3",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.14.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "env-cmd": "^11.0.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
