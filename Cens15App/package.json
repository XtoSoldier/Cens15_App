{
  "name": "cens15app",
  "version": "1.0.0",
  "packageManager": "pnpm@10.18.2",
  "main": "index.ts",
  "scripts": {
    "start": "pnpm run dev:local-api",
    "dev:local-api": "env-cmd -f .env.local-api -- expo start --lan",
    "dev:prod-api": "env-cmd -f .env.prod-api -- expo start --lan",
    "web:local-api": "env-cmd -f .env.local-api -- expo start --web",
    "web:prod-api": "env-cmd -f .env.prod-api -- expo start --web",
    "build:web:prod": "env-cmd -f .env.production -- expo export --platform web --clear",
    "build:web:intranet": "env-cmd -f .env.intranet -- expo export --platform web --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:horarios": "node --experimental-strip-types --test tests/horarios.test.cjs",
    "test:env": "node --test tests/env.test.cjs",
    "test:access": "node --test tests/apiHealth.test.cjs tests/register.test.cjs tests/resetPassword.test.cjs",
    "test:session": "node --test tests/sessionExpiry.test.cjs",
    "test:calificaciones": "node --experimental-strip-types --test tests/calificaciones.test.cjs tests/gradingScreens.test.cjs"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@reduxjs/toolkit": "^2.5.0",
    "expo": "~58.0.23",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-image-picker": "~58.0.10",
    "expo-local-authentication": "~58.0.2",
    "expo-print": "~58.0.8",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-paper": "^5.14.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "env-cmd": "^11.0.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
